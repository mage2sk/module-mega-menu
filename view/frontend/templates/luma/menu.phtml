<?php
/**
 * @var \Panth\MegaMenu\Block\Menu $block
 * @var \Magento\Framework\Escaper $escaper
 */

if (!$block->isEnabled()) {
    return;
}

$menuTree = $block->getCurrentMenuTree();
if (empty($menuTree)) {
    return;
}

$menu = $block->getCurrentMenu();
$helper = $block->getMenuHelper();
$breakpoint = (int) $block->getMobileBreakpoint();
$menuCss = $menu ? trim((string) $menu->getCustomCss()) : '';
$globalCss = trim((string) $helper->getCustomCss());

$block->setData('pmm_items', $menuTree);
$block->setData('pmm_config', [
    'source' => 'menu',
    'renderer' => $block->getMenuRenderer(),
    'menu' => $menu,
    'max_depth' => (int) ($helper->getMaxDepth() ?: 5),
    'show_icons' => (bool) $helper->showIcons(),
    'show_images' => (bool) $helper->showImages(),
    'show_count' => (bool) $helper->showCategoryCount(),
    'enable_blocks' => (bool) $helper->isCustomBlocksEnabled(),
    'hover_delay' => (int) $helper->getHoverIntentDelay(),
    'hover_effect' => (string) ($helper->getHoverEffect() ?: 'underline'),
    'animation' => (string) ($helper->getAnimationType() ?: 'slide'),
    'mobile_position' => (string) ($helper->getMobilePosition() ?: 'left'),
    'breakpoint' => $breakpoint > 0 ? $breakpoint : 1023,
    'toggle_label' => ($block->getData('menu_identifier') && $menu) ? (string) $menu->getTitle() : '',
    'nav_label' => $menu && $block->getData('menu_identifier') ? (string) $menu->getTitle() : (string) __('Main menu'),
    'css_class' => $menu ? (string) $menu->getCssClass() : '',
    'custom_css' => trim($globalCss . "\n" . $menuCss),
    'js_url' => $block->getViewFileUrl('Panth_MegaMenu::js/pmm.js'),
    'timezone' => (string) ($helper->getConfigValue('general/locale/timezone') ?: 'UTC'),
]);
?>
<?php if ($breakpoint > 0): ?>
<style>
@media (min-width: <?= (int) ($breakpoint + 1) ?>px) {
    .header.content:has(> .pmm) { display: flex !important; align-items: center; flex-wrap: nowrap; gap: 8px; }
    .header.content:has(> .pmm) > .logo { order: 1; flex-shrink: 0; float: none !important; margin: 0 !important; padding: 8px 0; }
    .header.content > .pmm { order: 2; flex: 1 1 0%; min-width: 0; margin: 0 12px; }
    .header.content:has(> .pmm) > .panth-header-icons { order: 3; flex-shrink: 0; }
    .header.content:has(> .pmm) > .panth-search-bar { order: 4; }
    .header.content:has(> .pmm) > .action.nav-toggle,
    .header.content:has(> .pmm) > .block-search,
    .header.content:has(> .pmm) > .minicart-wrapper,
    .header.content:has(> .pmm) > .compare.wrapper { display: none !important; }
}
</style>
<?php endif; ?>
<?= /* @noEscape */ $block->fetchView($block->getTemplateFile('Panth_MegaMenu::pmm/render.phtml')) ?>
